				"main"     : {"flex": 1, "minWidth": 0},
				"content"  : {"padding": "32px 0"},
				"footer"   : {
					"padding"  : "24px 0",
					"borderTop": "1px solid #EBECF0",
					"marginTop": "auto"
				}
			},
			"formLayout"     : {
				"container": {"maxWidth": "600px", "margin": "0 auto"},
				"section"  : {
					"marginBottom"   : "32px",
					"padding"        : "24px",
					"backgroundColor": "#FFFFFF",
					"borderRadius"   : "6px",
					"border"         : "1px solid #EBECF0"
				},
				"actions"  : {
					"display"       : "flex",
					"gap"           : "12px",
					"justifyContent": "flex-end",
					"marginTop"     : "24px"
				}
			},
			"listLayout"     : {
				"toolbar": {
					"display"       : "flex",
					"justifyContent": "space-between",
					"marginBottom"  : "16px",
					"flexWrap"      : "wrap",
					"gap"           : "12px"
				},
				"filters": {"display": "flex", "gap": "8px", "flexWrap": "wrap"},
				"results": {"marginTop": "16px"},
				"empty"  : {
					"textAlign": "center",
					"padding"  : "48px 24px",
					"color"    : "#5E6C84"
				}
			},
			"dashboardLayout": {
				"grid"       : {
					"display"            : "grid",
					"gap"                : "24px",
					"gridTemplateColumns": "repeat(12, 1fr)"
				},
				"widget"     : {
					"backgroundColor": "#FFFFFF",
					"borderRadius"   : "6px",
					"border"         : "1px solid #EBECF0",
					"overflow"       : "hidden"
				},
				"widgetSizes": {
					"full"   : "grid-column: span 12",
					"half"   : "grid-column: span 6",
					"third"  : "grid-column: span 4",
					"quarter": "grid-column: span 3"
				}
			},
			"kanbanLayout"   : {
				"container"   : {
					"display"  : "flex",
					"gap"      : "20px",
					"overflowX": "auto",
					"padding"  : "16px 0"
				},
				"column"      : {
					"minWidth"       : "300px",
					"backgroundColor": "#F4F5F7",
					"borderRadius"   : "6px",
					"padding"        : "12px"
				},
				"columnHeader": {
					"padding"     : "8px 12px",
					"fontWeight"  : 600,
					"color"       : "#172B4D",
					"marginBottom": "12px"
				},
				"columnCards" : {
					"display"      : "flex",
					"flexDirection": "column",
					"gap"          : "12px"
				},
				"addCard"     : {
					"marginTop"   : "12px",
					"padding"     : "8px 12px",
					"color"       : "#5E6C84",
					"cursor"      : "pointer",
					"borderRadius": "6px",
					"hover"       : {"backgroundColor": "#EBECF0"}
				}
			}
		},
		"pages": {
			"spaceDirectory"  : {
				"template"      : "dashboardLayout",
				"components"    : ["searchBar", "filterChips", "cardGrid", "pagination"],
				"specificStyles": {
					"cardGrid": {
						"display"            : "grid",
						"gap"                : "16px",
						"gridTemplateColumns": "repeat(auto-fill, minmax(320px, 1fr))"
					}
				}
			},
			"merchantDetails" : {
				"template"  : "pageLayout",
				"components": [
					"breadcrumbs",   "profileHeader", "tabs",          "metricsCards",
					"dataTable"
				]
			},
			"reviewFeedback"  : {
				"template"  : "listLayout",
				"components": [
					"feedbackList",   "ratingStars",    "commentBox",     "analyticsChart"
				]
			},
			"paymentSettings" : {
				"template"  : "formLayout",
				"components": ["formGroup", "toggle", "select", "saveButton"]
			},
			"ecommerceProduct": {
				"template"  : "pageLayout",
				"components": ["productCard", "filterChips", "sortDropdown", "pagination"]
			},
			"teamDirectory"   : {
				"template"  : "dashboardLayout",
				"components": ["searchBar", "userCard", "filterChips"]
			}
		},
		"radiusGuidelines": {
			"description": "Consistent border radius usage across all components",
			"mapping"    : {
				"6px"   : [
					"buttons",          "inputs",           "chips",
					"badges",           "cards",            "dropdowns",
					"tooltips",         "tables",           "pagination",
					"toasts",           "alerts",           "tabs",
					"accordions",       "datePickers",      "autocomplete",
					"listItems",        "emptyStates",      "progressBar",
					"segmentedControl", "productCard",      "commentCard",
					"notificationCard", "taskCard",         "metricCard",
					"drawer",           "skeleton"
				],
				"8px"   : ["modals"],
				"12px"  : [
					"elevated cards",    "featureCard",       "userCard",
					"bottomSheet (top)"
				],
				"16px"  : [],
				"24px"  : [],
				"9999px": [
					"avatars",             "pills",               "switches",
					"sliders",             "badge dots",          "radio buttons",
					"checkboxes (outer)",  "stepper indicators",  "presence indicators"
				]
			}
		},
		"designTokens": {
			"cssVariables" : {
				"--color-primary"    : "#0052CC",
				"--color-surface"    : "#FFFFFF",
				"--color-background" : "#F4F5F7",
				"--color-text"       : "#172B4D",
				"--color-text-subtle": "#42526E",
				"--color-border"     : "#DFE5EF",
				"--spacing-sm"       : "8px",
				"--spacing-md"       : "16px",
				"--spacing-lg"       : "24px",
				"--spacing-xl"       : "32px",
				"--radius-sm"        : "6px",
				"--radius-default"   : "6px",
				"--radius-md"        : "8px",
				"--radius-lg"        : "12px",
				"--radius-xl"        : "16px",
				"--radius-2xl"       : "24px",
				"--radius-full"      : "9999px",
				"--shadow-hover"     : "0px 4px 12px rgba(9, 30, 66, 0.12)",
				"--transition-base"  : "all 200ms cubic-bezier(0.4, 0, 0.2, 1)"
			},
			"scssVariables": {
				"$primary-blue"      : "#0052CC",
				"$neutral-bg"        : "#F4F5F7",
				"$spacing-unit"      : "8px",
				"$border-radius-base": "6px",
				"$border-radius-lg"  : "12px",
				"$border-radius-full": "9999px"
			},
			"jsTokens"     : {
				"theme": {
					"colors"      : {},
					"spacing"     : {},
					"typography"  : {},
					"borderRadius": {
						"sm"     : "6px",
						"default": "6px",
						"md"     : "8px",
						"lg"     : "12px",
						"xl"     : "16px",
						"2xl"    : "24px",
						"full"   : "9999px"
					}
				}
			}
		},
		"componentMapping": {
			"atomsToMolecules"    : {
				"color + typography + spacing → button": true,
				"border + shadow + animation → card"   : true,
				"color + typography + sizing → badge"  : true
			},
			"moleculesToOrganisms": {
				"button + input + formGroup → modal"      : true,
				"chip + pagination + card → table"        : true,
				"avatar + badge + icon → dropdown"        : true,
				"button + icon + avatar → userCard"       : true,
				"icon + typography + button → featureCard": true
			},
			"organismsToTemplates": {
				"card + modal + table → pageLayout"            : true,
				"formGroup + dropdown + button → formLayout"   : true,
				"metricCard + widget + table → dashboardLayout": true,
				"taskCard + column → kanbanLayout"             : true
			}
		}
	}
}
