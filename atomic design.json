{
	"atomicDesignSystem": {
		"version": "2.2.0",
		"description": "Complete Atomic Design System with atoms, molecules, organisms, templates, pages, and extended custom components",
		"atoms": {
			"colors"      : {
				"primary" : {
					"50"     : "#E9F2FF",
					"100"    : "#CCE0FF",
					"200"    : "#B3D4FF",
					"300"    : "#80B3FF",
					"400"    : "#4C8EFF",
					"500"    : "#0052CC",
					"600"    : "#003D99",
					"700"    : "#002966",
					"800"    : "#001433",
					"DEFAULT": "#0052CC"
				},
				"neutral" : {
					"white"     : "#FFFFFF",
					"background": "#F4F5F7",
					"surface"   : "#FFFFFF",
					"border"    : "#DFE5EF",
					"borderBold": "#B3BAC5",
					"text"      : "#172B4D",
					"textSubtle": "#42526E",
					"textMuted" : "#5E6C84",
					"icon"      : "#6B778C"
				},
				"semantic": {
					"success": "#00875A",
					"warning": "#FF991F",
					"danger" : "#DE350B",
					"info"   : "#2684FF"
				}
			},
			"typography"  : {
				"heading": {
					"h1": "font-size: 24px; font-weight: 700; line-height: 1.25; letter-spacing: -0.01em",
					"h2": "font-size: 20px; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em",
					"h3": "font-size: 18px; font-weight: 600; line-height: 1.3",
					"h4": "font-size: 16px; font-weight: 600; line-height: 1.4",
					"h5": "font-size: 14px; font-weight: 600; line-height: 1.4",
					"h6": "font-size: 12px; font-weight: 600; line-height: 1.4"
				},
				"body"   : {
					"large"  : "font-size: 16px; font-weight: 400; line-height: 1.5",
					"default": "font-size: 14px; font-weight: 400; line-height: 1.5",
					"small"  : "font-size: 12px; font-weight: 400; line-height: 1.5",
					"caption": "font-size: 11px; font-weight: 400; line-height: 1.4"
				},
				"weight" : {"normal": 400, "medium": 500, "semibold": 600, "bold": 700}
			},
			"spacing"     : {
				"base" : 8,
				"scale": {
					"xs" : "4px",
					"sm" : "8px",
					"md" : "16px",
					"lg" : "24px",
					"xl" : "32px",
					"2xl": "48px",
					"3xl": "64px"
				}
			},
			"borderRadius": {
				"none"   : "0px",
				"sm"     : "6px",
				"default": "6px",
				"md"     : "8px",
				"lg"     : "12px",
				"xl"     : "16px",
				"2xl"    : "24px",
				"full"   : "9999px"
			},
			"shadows"     : {
				"none": "none",
				"sm"  : "0px 1px 2px rgba(9, 30, 66, 0.08)",
				"md"  : "0px 4px 8px rgba(9, 30, 66, 0.12)",
				"lg"  : "0px 8px 16px rgba(9, 30, 66, 0.16)",
				"xl"  : "0px 12px 24px rgba(9, 30, 66, 0.20)"
			},
			"animation"   : {
				"duration": {"fast": "100ms", "base": "200ms", "slow": "300ms"},
				"easing"  : "cubic-bezier(0.4, 0, 0.2, 1)"
			}
		},
		"molecules": {
			"button"          : {
				"base"    : {
					"display"       : "inline-flex",
					"alignItems"    : "center",
					"justifyContent": "center",
					"gap"           : "8px",
					"height"        : "32px",
					"padding"       : "0 12px",
					"borderRadius"  : "6px",
					"fontSize"      : "14px",
					"fontWeight"    : 500,
					"transition"    : "all 200ms cubic-bezier(0.4, 0, 0.2, 1)",
					"cursor"        : "pointer"
				},
				"variants": {
					"primary"  : {
						"backgroundColor": "#0052CC",
						"color"          : "#FFFFFF",
						"border"         : "none",
						"hover"          : {"backgroundColor": "#003D99"},
						"active"         : {"backgroundColor": "#002966"}
					},
					"secondary": {
						"backgroundColor": "#FFFFFF",
						"color"          : "#42526E",
						"border"         : "1px solid #DFE5EF",
						"hover"          : {"backgroundColor": "#FAFBFC"},
						"active"         : {"backgroundColor": "#EBECF0"}
					},
					"subtle"   : {
						"backgroundColor": "transparent",
						"color"          : "#42526E",
						"border"         : "none",
						"hover"          : {"backgroundColor": "#EBECF0"},
						"active"         : {"backgroundColor": "#DFE5EF"}
					},
					"danger"   : {
						"backgroundColor": "#FFEBE6",
						"color"          : "#BF2600",
						"border"         : "none",
						"hover"          : {"backgroundColor": "#FFDDD4"},
						"active"         : {"backgroundColor": "#FFC9C1"}
					}
				},
				"sizes"   : {
					"small": {"height": "24px", "padding": "0 8px",  "fontSize": "12px"},
					"large": {"height": "40px", "padding": "0 16px", "fontSize": "16px"}
				},
				"states"  : {
					"disabled": {"opacity": 0.5, "cursor": "not-allowed"},
					"loading" : {"opacity": 0.7, "cursor": "wait"       }
				}
			},
			"input"           : {
				"base"       : {
					"height"         : "32px",
					"padding"        : "0 12px",
					"borderRadius"   : "6px",
					"border"         : "1px solid #DFE5EF",
					"backgroundColor": "#FFFFFF",
					"fontSize"       : "14px",
					"color"          : "#172B4D",
					"transition"     : "all 200ms cubic-bezier(0.4, 0, 0.2, 1)",
					"width"          : "100%"
				},
				"focus"      : {
					"borderColor": "#0052CC",
					"boxShadow"  : "0 0 0 2px rgba(0, 82, 204, 0.2)",
					"outline"    : "none"
				},
				"placeholder": {"color": "#7A869A"},
				"variants"   : {
					"error"   : {
						"borderColor"   : "#DE350B",
						"focusBoxShadow": "0 0 0 2px rgba(222, 53, 11, 0.2)"
					},
					"success" : {
						"borderColor"   : "#00875A",
						"focusBoxShadow": "0 0 0 2px rgba(0, 135, 90, 0.2)"
					},
					"disabled": {
						"backgroundColor": "#F4F5F7",
						"color"          : "#7A869A",
						"cursor"         : "not-allowed"
					}
				},
				"withIcon"   : {"paddingLeft": "32px"}
			},
			"chip"            : {
				"base"    : {
					"display"     : "inline-flex",
					"alignItems"  : "center",
					"gap"         : "6px",
					"height"      : "28px",
					"padding"     : "0 12px",
					"borderRadius": "6px",
					"fontSize"    : "14px",
					"fontWeight"  : 500,
					"transition"  : "all 200ms cubic-bezier(0.4, 0, 0.2, 1)",
					"cursor"      : "pointer"
				},
				"variants": {
					"default" : {
						"backgroundColor": "#F4F5F7",
						"color"          : "#42526E",
						"hover"          : {"backgroundColor": "#EBECF0"}
					},
					"selected": {
						"backgroundColor": "#0052CC",
						"color"          : "#FFFFFF",
						"hover"          : {"backgroundColor": "#003D99"}
					},
					"outline" : {
						"backgroundColor": "transparent",
						"border"         : "1px solid #DFE5EF",
						"color"          : "#42526E",
						"hover"          : {"backgroundColor": "#FAFBFC"}
					}
				},
				"sizes"   : {
					"small": {"height": "24px", "padding": "0 8px", "fontSize": "12px"}
				}
			},
			"badge"           : {
				"base"    : {
					"display"     : "inline-flex",
					"alignItems"  : "center",
					"padding"     : "2px 8px",
					"borderRadius": "6px",
					"fontSize"    : "12px",
					"fontWeight"  : 600,
					"lineHeight"  : 1.5
				},
				"variants": {
					"default": {"backgroundColor": "#F4F5F7", "color": "#42526E"},
					"success": {"backgroundColor": "#E3FCEF", "color": "#006644"},
					"warning": {"backgroundColor": "#FFF8E6", "color": "#CC7B00"},
					"danger" : {"backgroundColor": "#FFEBE6", "color": "#BF2600"},
					"info"   : {"backgroundColor": "#E9F2FF", "color": "#0052CC"}
				},
				"dot"     : {
					"width"       : "6px",
					"height"      : "6px",
					"borderRadius": "50%",
					"marginRight" : "6px"
				}
			},
			"avatar"          : {
				"base"    : {
					"display"        : "flex",
					"alignItems"     : "center",
					"justifyContent" : "center",
					"borderRadius"   : "9999px",
					"backgroundColor": "#DFE5EF",
					"color"          : "#42526E",
					"fontWeight"     : 500,
					"overflow"       : "hidden"
				},
				"sizes"   : {
					"xs": {"width": "20px", "height": "20px", "fontSize": "10px"},
					"sm": {"width": "24px", "height": "24px", "fontSize": "12px"},
					"md": {"width": "32px", "height": "32px", "fontSize": "14px"},
					"lg": {"width": "40px", "height": "40px", "fontSize": "16px"},
					"xl": {"width": "48px", "height": "48px", "fontSize": "20px"}
				},
				"presence": {
					"online" : {"border": "2px solid #00875A"},
					"offline": {"border": "2px solid #B3BAC5"},
					"busy"   : {"border": "2px solid #DE350B"}
				}
			},
			"icon"            : {
				"base"  : {
					"display"       : "inline-flex",
					"alignItems"    : "center",
					"justifyContent": "center",
					"flexShrink"    : 0
				},
				"sizes" : {
					"xs": "12px",
					"sm": "14px",
					"md": "16px",
					"lg": "20px",
					"xl": "24px"
				},
				"colors": {
					"default": "color: #6B778C",
					"primary": "color: #0052CC",
					"success": "color: #00875A",
					"warning": "color: #FF991F",
					"danger" : "color: #DE350B"
				}
			},
			"divider"         : {
				"base"    : {
					"height"         : "1px",
					"backgroundColor": "#EBECF0",
					"margin"         : "16px 0"
				},
				"variants": {
					"subtle"  : {"backgroundColor": "#F4F5F7"},
					"bold"    : {"backgroundColor": "#DFE5EF"},
					"vertical": {"width": "1px", "height": "auto", "margin": "0 16px"}
				}
			},
			"switch"          : {
				"base"    : {
					"position": "relative",
					"display" : "inline-block",
					"width"   : "44px",
					"height"  : "24px"
				},
				"track"   : {
					"position"       : "absolute",
					"cursor"         : "pointer",
					"top"            : 0,
					"left"           : 0,
					"right"          : 0,
					"bottom"         : 0,
					"backgroundColor": "#DFE5EF",
					"borderRadius"   : "9999px",
					"transition"     : "all 200ms cubic-bezier(0.4, 0, 0.2, 1)"
				},
				"thumb"   : {
					"position"       : "absolute",
					"height"         : "20px",
					"width"          : "20px",
					"left"           : "2px",
					"bottom"         : "2px",
					"backgroundColor": "#FFFFFF",
					"borderRadius"   : "9999px",
					"transition"     : "all 200ms cubic-bezier(0.4, 0, 0.2, 1)"
				},
				"checked" : {
					"track": {"backgroundColor": "#0052CC"                                 },
					"thumb": {                              "transform": "translateX(20px)"}
				},
				"disabled": {"opacity": 0.5, "cursor": "not-allowed"}
			},
			"slider"          : {
				"track" : {
					"height"         : "4px",
					"backgroundColor": "#DFE5EF",
					"borderRadius"   : "9999px"
				},
				"filled": {
					"height"         : "4px",
					"backgroundColor": "#0052CC",
					"borderRadius"   : "9999px"
				},
				"thumb" : {
					"width"          : "16px",
					"height"         : "16px",
					"backgroundColor": "#0052CC",
					"borderRadius"   : "9999px",
					"boxShadow"      : "0px 2px 4px rgba(9, 30, 66, 0.25)",
					"cursor"         : "pointer"
				}
			},
			"progressBar"     : {
				"track"   : {
					"height"         : "8px",
					"backgroundColor": "#F4F5F7",
					"borderRadius"   : "9999px",
					"overflow"       : "hidden"
				},
				"fill"    : {
					"height"         : "100%",
					"backgroundColor": "#0052CC",
					"borderRadius"   : "9999px",
					"transition"     : "width 300ms ease"
				},
				"sizes"   : { "small": {"height": "4px"}, "large": {"height": "12px"} },
				"variants": {
					"success": {"backgroundColor": "#00875A"},
					"warning": {"backgroundColor": "#FF991F"},
					"danger" : {"backgroundColor": "#DE350B"}
				}
			},
			"skeleton"        : {
				"base"    : {
					"backgroundColor": "#F4F5F7",
					"borderRadius"   : "6px",
					"animation"      : "pulse 1.5s ease-in-out infinite"
				},
				"text"    : {"height": "16px", "borderRadius": "6px"},
				"circle"  : {"borderRadius": "9999px"},
				"variants": {
					"card"  : {"borderRadius": "6px"   },
					"avatar": {"borderRadius": "9999px"},
					"button": {"borderRadius": "6px"   }
				}
			},
			"tabs"            : {
				"container": {
					"display"     : "flex",
					"borderBottom": "1px solid #EBECF0",
					"gap"         : "0"
				},
				"tab"      : {
					"padding"     : "12px 16px",
					"fontSize"    : "14px",
					"fontWeight"  : 500,
					"color"       : "#42526E",
					"cursor"      : "pointer",
					"borderBottom": "2px solid transparent",
					"transition"  : "all 150ms ease"
				},
				"active"   : {"color": "#0052CC", "borderBottom": "2px solid #0052CC"},
				"hover"    : {"color": "#172B4D", "backgroundColor": "#FAFBFC"},
				"disabled" : {"opacity": 0.5, "cursor": "not-allowed"},
				"variants" : {
					"pills"     : {
						"container": {"borderBottom": "none", "gap": "8px"},
						"tab"      : {"borderRadius": "6px", "borderBottom": "none"},
						"active"   : {"backgroundColor": "#0052CC", "color": "#FFFFFF"}
					},
					"underlined": { "tab": {"padding": "12px 0", "marginRight": "24px"} }
				}
			},
			"accordion"       : {
				"item"    : {"borderBottom": "1px solid #EBECF0"},
				"header"  : {
					"padding"       : "16px 0",
					"display"       : "flex",
					"justifyContent": "space-between",
					"alignItems"    : "center",
					"cursor"        : "pointer",
					"fontWeight"    : 500,
					"color"         : "#172B4D"
				},
				"content" : {"paddingBottom": "16px", "color": "#42526E"},
				"icon"    : {"transition": "transform 200ms ease"},
				"expanded": { "icon": {"transform": "rotate(180deg)"} }
			},
			"breadcrumbs"     : {
				"container": {
					"display"   : "flex",
					"alignItems": "center",
					"gap"       : "8px",
					"fontSize"  : "14px"
				},
				"item"     : {"color": "#42526E", "cursor": "pointer"},
				"active"   : {"color": "#172B4D", "fontWeight": 500, "cursor": "default"},
				"separator": {"color": "#B3BAC5"},
				"hover"    : {"color": "#0052CC", "textDecoration": "underline"}
			},
			"tag"             : {
				"base"      : {
					"display"        : "inline-flex",
					"alignItems"     : "center",
					"padding"        : "4px 10px",
					"borderRadius"   : "6px",
					"fontSize"       : "12px",
					"fontWeight"     : 500,
					"backgroundColor": "#F4F5F7",
					"color"          : "#42526E"
				},
				"removable" : {
					"cursor": "pointer",
					"hover" : {"backgroundColor": "#EBECF0"}
				},
				"removeIcon": {"marginLeft": "6px", "cursor": "pointer"},
				"sizes"     : {
					"small": {"padding": "2px 8px",  "fontSize": "11px"},
					"large": {"padding": "6px 12px", "fontSize": "14px"}
				}
			},
			"toast"           : {
				"container": {
					"position"     : "fixed",
					"bottom"       : "24px",
					"right"        : "24px",
					"zIndex"       : 1100,
					"display"      : "flex",
					"flexDirection": "column",
					"gap"          : "12px"
				},
				"item"     : {
					"display"        : "flex",
					"alignItems"     : "center",
					"gap"            : "12px",
					"padding"        : "12px 16px",
					"backgroundColor": "#FFFFFF",
					"borderRadius"   : "6px",
					"boxShadow"      : "0px 4px 12px rgba(9, 30, 66, 0.15)",
					"borderLeft"     : "3px solid #0052CC",
					"minWidth"       : "280px",
					"animation"      : "slideIn 300ms ease"
				},
				"variants" : {
					"success": {"borderLeftColor": "#00875A"},
					"warning": {"borderLeftColor": "#FF991F"},
					"error"  : {"borderLeftColor": "#DE350B"},
					"info"   : {"borderLeftColor": "#2684FF"}
				},
				"close"    : {"marginLeft": "auto", "cursor": "pointer", "color": "#7A869A"}
			},
			"segmentedControl": {
				"container": {
					"display"        : "inline-flex",
					"backgroundColor": "#F4F5F7",
					"borderRadius"   : "6px",
					"padding"        : "4px"
				},
				"option"   : {
					"padding"     : "6px 16px",
					"fontSize"    : "14px",
					"fontWeight"  : 500,
					"color"       : "#42526E",
					"borderRadius": "6px",
					"cursor"      : "pointer",
					"transition"  : "all 150ms ease"
				},
				"active"   : {
					"backgroundColor": "#FFFFFF",
					"color"          : "#0052CC",
					"boxShadow"      : "0px 1px 2px rgba(9, 30, 66, 0.08)"
				},
				"disabled" : {"opacity": 0.5, "cursor": "not-allowed"}
			},
			"stepper"         : {
				"container": {"display": "flex", "alignItems": "center", "gap": "8px"},
				"step"     : {
					"display"      : "flex",
					"flexDirection": "column",
					"alignItems"   : "center",
					"flex"         : 1,
					"position"     : "relative"
				},
				"indicator": {
					"width"          : "32px",
					"height"         : "32px",
					"borderRadius"   : "9999px",
					"backgroundColor": "#F4F5F7",
					"color"          : "#42526E",
					"display"        : "flex",
					"alignItems"     : "center",
					"justifyContent" : "center",
					"fontWeight"     : 500,
					"position"       : "relative",
					"zIndex"         : 2
				},
				"line"     : {
					"position"       : "absolute",
					"top"            : "16px",
					"left"           : "calc(50% + 20px)",
					"right"          : "calc(-50% + 20px)",
					"height"         : "2px",
					"backgroundColor": "#EBECF0",
					"zIndex"         : 1
				},
				"label"    : {"marginTop": "8px", "fontSize": "12px", "color": "#5E6C84"},
				"active"   : {
					"indicator": {"backgroundColor": "#0052CC", "color": "#FFFFFF"},
					"label"    : {"color": "#0052CC", "fontWeight": 500}
				},
				"completed": {
					"indicator": {"backgroundColor": "#00875A", "color": "#FFFFFF"}
				}
			}
		},
		"organisms": {
			"card"            : {
				"base"       : {
					"backgroundColor": "#FFFFFF",
					"border"         : "1px solid #EBECF0",
					"borderRadius"   : "6px",
					"overflow"       : "hidden",
					"transition"     : "all 200ms cubic-bezier(0.4, 0, 0.2, 1)"
				},
				"interactive": {
					"cursor": "pointer",
					"hover" : {
						"boxShadow": "0px 4px 12px rgba(9, 30, 66, 0.12)",
						"transform": "translateY(-1px)"
					},
					"active": {"transform": "translateY(0)"}
				},
				"parts"      : {
					"header": {"padding": "16px 20px 0 20px", "borderBottom": "none"},
					"body"  : {"padding": "16px 20px"},
					"footer": {
						"padding"        : "12px 20px",
						"borderTop"      : "1px solid #EBECF0",
						"backgroundColor": "#FAFBFC"
					}
				},
				"variants"   : {
					"elevated": {
						"boxShadow"   : "0px 4px 12px rgba(9, 30, 66, 0.12)",
						"border"      : "none",
						"borderRadius": "12px"
					},
					"compact" : {
						"parts": { "body": {"padding": "12px 16px"} }
					}
				}
			},
			"productCard"     : {
				"base"       : {
					"backgroundColor": "#FFFFFF",
					"borderRadius"   : "6px",
					"overflow"       : "hidden",
					"transition"     : "all 200ms cubic-bezier(0.4, 0, 0.2, 1)",
					"border"         : "1px solid #EBECF0"
				},
				"image"      : {
					"width"               : "100%",
					"height"              : "200px",
					"objectFit"           : "cover",
					"borderTopLeftRadius" : "6px",
					"borderTopRightRadius": "6px"
				},
				"content"    : {"padding": "16px"},
				"title"      : {
					"fontSize"    : "16px",
					"fontWeight"  : 600,
					"color"       : "#172B4D",
					"marginBottom": "8px"
				},
				"price"      : {
					"fontSize"    : "20px",
